<Window x:Class="DevBar.MainPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevBar"
        Width="460" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Visibility="Collapsed"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <DockPanel>
            <!-- Command bar -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ToggleButton x:Name="PinButton"
                              Grid.Column="1"
                              Margin="8,0,0,0"
                              Content="📌"
                              Width="34" Height="34"
                              Cursor="Hand"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{StaticResource TextDimBrush}"
                              ToolTip="Keep DevBar open when it loses focus" />

                <!-- Search with icon -->
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="30,7,8,7" />
                    <TextBlock Text="🔍" FontSize="13" Margin="9,0,0,0"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}" />
                    <TextBlock Text="Search tabs and commands…  (try &quot;kill 3000&quot;)"
                               Margin="30,0,0,0"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DimText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <!-- Palette results overlay the tab strip when searching -->
            <Border DockPanel.Dock="Top"
                    Style="{StaticResource Card}"
                    Margin="0,0,0,10"
                    Visibility="{Binding IsPaletteOpen, Converter={StaticResource BoolToVis}}">
                <ListBox ItemsSource="{Binding FilteredCommands}"
                         MaxHeight="180"
                         MouseLeftButtonUp="OnPaletteItemClicked">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Tab strip with icons (no ScrollViewer — WrapPanel shows all rows) -->
            <ItemsControl DockPanel.Dock="Top"
                          ItemsSource="{Binding Tabs}"
                          Margin="0,0,0,10"
                          Visibility="{Binding IsPaletteOpen, Converter={StaticResource BoolToVisInverted}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource TabButton}"
                                     GroupName="Tabs"
                                     Margin="0,0,1,3"
                                     Checked="OnTabChecked"
                                     Tag="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontSize="11" Margin="0,0,3,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="11.5" />
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Thin separator -->
            <Border DockPanel.Dock="Top" Height="1"
                    Background="{StaticResource BorderBrush}"
                    Margin="0,0,0,10"
                    Visibility="{Binding IsPaletteOpen, Converter={StaticResource BoolToVisInverted}}" />

            <!-- Active tab content -->
            <ScrollViewer x:Name="ContentScroller"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="OnContentScroll">
                <ContentControl Content="{Binding SelectedTab.ViewModel}" Margin="2,0" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
