<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DevBar.ViewModels"
                    xmlns:controls="clr-namespace:DevBar.Controls"
                    xmlns:local="clr-namespace:DevBar">

    <local:BytesConverter x:Key="Bytes" />
    <local:StateToBrushConverter x:Key="StateToBrush" />
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    <local:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True" />
    <local:StringNotEmptyToVisibilityConverter x:Key="StringToVis" />

    <!-- ═══ Vitals ═══ -->
    <DataTemplate DataType="{x:Type vm:VitalsViewModel}">
        <StackPanel Margin="2">

            <!-- Machine weather -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding WeatherGlyph}" FontSize="26"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                               Margin="2,0,12,0" FontWeight="Bold" />
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource MonoText}"
                               Foreground="{StaticResource TextDimBrush}"
                               Text="{Binding CpuPercent, StringFormat=CPU {0:F0}%}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding WeatherLabel}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding WeatherDetail}" Style="{StaticResource DimText}" Margin="0,1,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Processor -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="PROCESSOR" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:F1}%}"
                               FontSize="26" FontWeight="Bold" Style="{StaticResource MonoText}" Margin="0,0,0,6" />
                    <controls:Sparkline Values="{Binding CpuHistoryValues}" Height="36"
                                        Stroke="{StaticResource AccentBrush}" />
                </StackPanel>
            </Border>

            <!-- Memory -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="MEMORY" Style="{StaticResource SectionHeader}" Margin="0" />
                        <TextBlock Text="{Binding MemoryDetail}" HorizontalAlignment="Right"
                                   Style="{StaticResource DimText}" VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock Text="{Binding MemoryPercent, StringFormat={}{0:F1}%}"
                               FontSize="26" FontWeight="Bold" Style="{StaticResource MonoText}" Margin="0,0,0,6"
                               Foreground="{StaticResource MemAccentBrush}" />
                    <controls:Sparkline Values="{Binding MemHistoryValues}" Height="36"
                                        Stroke="{StaticResource MemAccentBrush}" />
                </StackPanel>
            </Border>

            <!-- Network -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="NETWORK" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="↓ Download" Style="{StaticResource DimText}" />
                            <TextBlock Text="{Binding DownRateText}" FontSize="16" FontWeight="SemiBold"
                                       Style="{StaticResource MonoText}" Foreground="{StaticResource NetDownBrush}"
                                       Margin="0,2,0,4" />
                            <controls:Sparkline Values="{Binding RxHistoryValues}" Height="28"
                                                AutoScale="True" Maximum="1024"
                                                Stroke="{StaticResource NetDownBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="↑ Upload" Style="{StaticResource DimText}" />
                            <TextBlock Text="{Binding UpRateText}" FontSize="16" FontWeight="SemiBold"
                                       Style="{StaticResource MonoText}" Foreground="{StaticResource NetUpBrush}"
                                       Margin="0,2,0,4" />
                            <controls:Sparkline Values="{Binding TxHistoryValues}" Height="28"
                                                AutoScale="True" Maximum="1024"
                                                Stroke="{StaticResource NetUpBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Drives -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="DRIVES" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource MonoText}" FontWeight="SemiBold" />
                                    <ProgressBar Grid.Column="1" Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource DimText}"
                                               Text="{Binding FreeBytes, Converter={StaticResource Bytes}, StringFormat={}{0} free}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Machine -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="MACHINE" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding MachineFacts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <TextBlock DockPanel.Dock="Left" Width="56" Text="{Binding Label}"
                                               Style="{StaticResource DimText}" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Content="⧉" Padding="5,1" Margin="6,0,0,0"
                                            ToolTip="Copy"
                                            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Value}" />
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource MonoText}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" TextAlignment="Right" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="Uptime" Style="{StaticResource DimText}" />
                        <TextBlock Text="{Binding UptimeText}" HorizontalAlignment="Right" Style="{StaticResource MonoText}" />
                    </Grid>
                    <Grid Margin="0,4,0,0"
                          Visibility="{Binding BatteryText, Converter={StaticResource StringToVis}}">
                        <TextBlock Text="Battery" Style="{StaticResource DimText}" />
                        <TextBlock Text="{Binding BatteryText}" HorizontalAlignment="Right" Style="{StaticResource MonoText}" />
                    </Grid>
                    <TextBlock Text="{Binding SensorsText}" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- ═══ Ports ═══ -->
    <DataTemplate DataType="{x:Type vm:PortsViewModel}">
        <DockPanel Margin="2">
            <TextBox DockPanel.Dock="Top" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,8" />
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Style="{StaticResource DimText}"
                       Margin="0,8,0,0" TextWrapping="Wrap" />
            <ListBox ItemsSource="{Binding Ports}" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Protocol}" Style="{StaticResource DimText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Port, StringFormat=:{0}}"
                                       Style="{StaticResource MonoText}" Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center">
                                <Run Text="{Binding ProcessName, Mode=OneWay}" />
                                <Run Text="{Binding Pid, Mode=OneWay, StringFormat=({0})}"
                                     Foreground="{StaticResource TextDimBrush}" />
                            </TextBlock>
            <Button Grid.Column="3" Content="⧉" Padding="6,3" Margin="0,0,4,0"
                                    ToolTip="Copy port number"
                                    Command="{Binding DataContext.CopyPortCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                            <Button Grid.Column="4" Content="↗" Padding="7,3"
                                    ToolTip="{Binding Port, StringFormat=Open http://localhost:{0}/ in browser}"
                                    Command="{Binding DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Protocol}" Value="UDP">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="5" Content="Kill" Style="{StaticResource DangerButton}"
                                    Padding="8,3" Margin="4,0,0,0"
                                    Command="{Binding DataContext.KillCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DataTemplate>

    <!-- ═══ Network ═══ -->
    <DataTemplate DataType="{x:Type vm:NetworkViewModel}">
        <StackPanel Margin="2">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Public IP" Style="{StaticResource DimText}" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="⧉" Padding="6,2" Margin="6,0,0,0"
                                ToolTip="Copy public IP"
                                Command="{Binding CopyCommand}" CommandParameter="{Binding PublicIp}" />
                        <TextBlock Text="{Binding PublicIp}" HorizontalAlignment="Right" Style="{StaticResource MonoText}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <TextBlock Text="DNS" Style="{StaticResource DimText}" />
                        <TextBlock Text="{Binding DnsServers}" HorizontalAlignment="Right" Style="{StaticResource MonoText}"
                                   TextWrapping="Wrap" MaxWidth="260" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="INTERFACES" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Interfaces}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <Button DockPanel.Dock="Right" Content="⧉" Padding="6,2" Margin="6,0,0,0"
                                            VerticalAlignment="Center" ToolTip="Copy IP address"
                                            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Addresses[0]}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource DimText}">
                                            <Run Text="{Binding Addresses[0], Mode=OneWay}" />
                                            <Run Text="{Binding Gateway, Mode=OneWay, StringFormat=· gw {0}}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="PING" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Ping" Style="{StaticResource AccentButton}"
                                Margin="8,0,0,0" Command="{Binding PingCommand}" />
                        <TextBox Text="{Binding PingHost, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Text="{Binding PingResult}" Style="{StaticResource MonoText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- ═══ Packages ═══ -->
    <DataTemplate DataType="{x:Type vm:PackagesViewModel}">
        <DockPanel Margin="2">
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Style="{StaticResource DimText}"
                       Margin="0,8,0,0" TextWrapping="Wrap" />
            <ListBox ItemsSource="{Binding Upgrades}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource DimText}" Margin="0,2,0,0">
                                    <Run Text="{Binding CurrentVersion, Mode=OneWay}" />
                                    <Run Text="→" Foreground="{StaticResource TextDimBrush}" />
                                    <Run Text="{Binding AvailableVersion, Mode=OneWay}" Foreground="{StaticResource OkBrush}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Upgrade" Style="{StaticResource AccentButton}"
                                    VerticalAlignment="Center" Padding="10,4"
                                    Command="{Binding DataContext.UpgradeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DataTemplate>

    <!-- ═══ Docker ═══ -->
    <DataTemplate DataType="{x:Type vm:DockerViewModel}">
        <DockPanel Margin="2">
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Style="{StaticResource DimText}"
                       Margin="0,8,0,0" TextWrapping="Wrap" />
            <ListBox ItemsSource="{Binding Containers}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource DimText}" TextTrimming="CharacterEllipsis" Margin="16,2,0,0">
                                    <Run Text="{Binding Image, Mode=OneWay}" />
                                    <Run Text="{Binding Status, Mode=OneWay, StringFormat=· {0}}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="▶" Padding="7,3" ToolTip="Start"
                                        Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="■" Padding="7,3" Margin="4,0,0,0" ToolTip="Stop"
                                        Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="↻" Padding="7,3" Margin="4,0,0,0" ToolTip="Restart"
                                        Command="{Binding DataContext.RestartCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DataTemplate>

    <!-- ═══ WSL ═══ -->
    <DataTemplate DataType="{x:Type vm:WslViewModel}">
        <DockPanel Margin="2">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Shutdown all" Style="{StaticResource DangerButton}"
                        Command="{Binding ShutdownAllCommand}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource DimText}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>
            <ListBox ItemsSource="{Binding Distros}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text=" (default)" Style="{StaticResource DimText}"
                                               Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource DimText}" Margin="0,2,0,0">
                                    <Run Text="{Binding State, Mode=OneWay}" />
                                    <Run Text="{Binding Version, Mode=OneWay, StringFormat=· WSL{0}}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Terminal" Padding="8,3" Style="{StaticResource AccentButton}"
                                        Command="{Binding DataContext.OpenTerminalCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Stop" Padding="8,3" Margin="4,0,0,0" Style="{StaticResource DangerButton}"
                                        Command="{Binding DataContext.TerminateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DataTemplate>

    <!-- ═══ Startup apps ═══ -->
    <DataTemplate DataType="{x:Type vm:StartupAppsViewModel}">
        <DockPanel Margin="2">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Task Manager" Command="{Binding OpenTaskManagerCommand}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource DimText}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>
            <ListBox ItemsSource="{Binding Apps}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource DimText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                    <Run Text="{Binding SourceLabel, Mode=OneWay}" />
                                    <Run Text="{Binding Command, Mode=OneWay, StringFormat=· {0}}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DataTemplate>

    <!-- ═══ Hosts ═══ -->
    <DataTemplate DataType="{x:Type vm:HostsViewModel}">
        <DockPanel Margin="2">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource AccentButton}"
                            Margin="8,0,0,0" Command="{Binding AddCommand}" />
                    <TextBox Width="100" DockPanel.Dock="Left" Text="{Binding NewIp, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Margin="6,0,0,0" Text="{Binding NewHost, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Open in Notepad" Command="{Binding OpenInNotepadCommand}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource DimText}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>
            <ListBox ItemsSource="{Binding Entries}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding IpAddress}" Style="{StaticResource MonoText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding HostName}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="On/Off" Padding="8,3"
                                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="✕" Padding="8,3" Margin="4,0,0,0" Style="{StaticResource DangerButton}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DataTemplate>

    <!-- ═══ Tools ═══ -->
    <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
        <StackPanel Margin="2">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="QUICK ACTIONS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button Content="Flush DNS" Margin="0,0,6,6" Command="{Binding FlushDnsCommand}"
                                ToolTip="ipconfig /flushdns" />
                        <Button Content="Renew DHCP" Margin="0,0,6,6" Command="{Binding RenewDhcpCommand}"
                                ToolTip="ipconfig /renew" />
                        <Button Content="Restart Explorer" Margin="0,0,6,6" Command="{Binding RestartExplorerCommand}"
                                ToolTip="Restarts explorer.exe — fixes a frozen taskbar or tray" />
                        <Button Content="Open %TEMP%" Margin="0,0,6,6" Command="{Binding OpenTempFolderCommand}" />
                        <Button Content="Export snapshot" Margin="0,0,6,6" Style="{StaticResource AccentButton}"
                                Command="{Binding ExportSnapshotCommand}"
                                ToolTip="Save vitals, ports, and network state as JSON" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="DIAGNOSTICS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button Content="ipconfig /all" Margin="0,0,6,6"
                                Command="{Binding RunDiagnosticCommand}" CommandParameter="ipconfig" />
                        <Button Content="Routes" Margin="0,0,6,6"
                                Command="{Binding RunDiagnosticCommand}" CommandParameter="routes" />
                        <Button Content="ARP table" Margin="0,0,6,6"
                                Command="{Binding RunDiagnosticCommand}" CommandParameter="arp" />
                        <Button Content="DNS cache" Margin="0,0,6,6"
                                Command="{Binding RunDiagnosticCommand}" CommandParameter="dns" />
                    </WrapPanel>
                    <TextBox Text="{Binding OutputText, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Cascadia Mono, Consolas" FontSize="11"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             Visibility="{Binding OutputText, Converter={StaticResource StringToVis}}"
                             Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusText}" Style="{StaticResource DimText}" TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>

    <!-- ═══ Timeline ═══ -->
    <DataTemplate DataType="{x:Type vm:TimelineViewModel}">
        <ListBox ItemsSource="{Binding Events}" Margin="2" VirtualizingPanel.IsVirtualizing="True">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Width="58" Style="{StaticResource MonoText}"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Text="{Binding Timestamp, StringFormat=HH:mm:ss}" VerticalAlignment="Top" />
                        <Border DockPanel.Dock="Left" Width="3" CornerRadius="2" Margin="4,2,8,2"
                                Background="{StaticResource AccentBrush}" Opacity="0.4" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource DimText}" FontSize="10.5"
                                       Text="{Binding Category}" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DataTemplate>

    <!-- ═══ Automations ═══ -->
    <DataTemplate DataType="{x:Type vm:AutomationsViewModel}">
        <DockPanel Margin="2">
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="NEW RULE" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                             ToolTip="Rule name (optional)" />
                    <DockPanel Margin="0,0,0,6">
                        <ComboBox Width="130" ItemsSource="{Binding TriggerKinds}" SelectedItem="{Binding NewTrigger}" />
                        <TextBox Margin="6,0,0,0" Text="{Binding NewTarget, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Port number or process name" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <ComboBox Width="130" ItemsSource="{Binding ActionKinds}" SelectedItem="{Binding NewAction}" />
                        <TextBox Margin="6,0,0,0" Text="{Binding NewArgument, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Command line (for RunCommand)" />
                    </DockPanel>
                    <Button Content="Add rule" Style="{StaticResource AccentButton}" HorizontalAlignment="Right"
                            Command="{Binding AddRuleCommand}" />
                </StackPanel>
            </Border>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Style="{StaticResource DimText}"
                       Margin="0,8,0,0" TextWrapping="Wrap" />
            <ListBox ItemsSource="{Binding Rules}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource DimText}" Margin="0,2,0,0">
                                    <Run Text="{Binding Trigger, Mode=OneWay}" />
                                    <Run Text="{Binding TriggerTarget, Mode=OneWay}" />
                                    <Run Text="→" />
                                    <Run Text="{Binding Action, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Padding="8,3"
                                        Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="Enable" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                    <Setter Property="Content" Value="Disable" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="✕" Padding="8,3" Margin="4,0,0,0" Style="{StaticResource DangerButton}"
                                        Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DataTemplate>

    <!-- ═══ Clocks ═══ -->
    <DataTemplate DataType="{x:Type vm:ClocksViewModel}">
        <DockPanel Margin="2">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                        Command="{Binding AddClockCommand}" />
                <ComboBox ItemsSource="{Binding AvailableZones}" IsEditable="True"
                          Text="{Binding SelectedZoneToAdd, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Clocks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Padding="6,2" Style="{StaticResource DangerButton}"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.RemoveClockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="22"
                                           Style="{StaticResource MonoText}" VerticalAlignment="Center" Margin="0,0,12,0"
                                           Foreground="{StaticResource AccentBrush}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding OffsetText}" Style="{StaticResource DimText}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </DataTemplate>

    <!-- ═══ Settings ═══ -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <StackPanel Margin="2">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="GENERAL" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                    <CheckBox Content="Launch at login" IsChecked="{Binding LaunchAtLogin}" Margin="0,0,0,8" />
                    <CheckBox Content="Stay awake (prevent sleep)" IsChecked="{Binding StayAwake}" Margin="0,0,0,8" />
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Refresh interval (ms)" Style="{StaticResource DimText}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding RefreshIntervalMs, UpdateSourceTrigger=LostFocus}" Width="80"
                                 HorizontalAlignment="Right" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Summon hotkey" Style="{StaticResource DimText}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HotkeyText}" Style="{StaticResource MonoText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="DATA" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                    <Button Content="Open settings folder" HorizontalAlignment="Left"
                            Command="{Binding OpenSettingsFolderCommand}" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource DimText}" Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
